# Flask 配置
SECRET_KEY=your-very-long-and-random-secret-key-change-this-in-production
FLASK_DEBUG=False

# Discord OAuth 配置
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://yourdomain.com/admin-panel/auth/discord/callback

# Session Cookie 安全性 (生產環境使用 HTTPS 時設為 True)
SESSION_COOKIE_SECURE=False

# Redis 配置 (可選，如果使用 Redis 作為 session 後端)
# REDIS_URL=redis://localhost:6379/0

# 其他配置
# SQLALCHEMY_DATABASE_URI=sqlite:///site.db
